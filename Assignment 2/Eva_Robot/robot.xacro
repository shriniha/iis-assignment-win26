<?xml version="1.0"?>
<robot name="domestic_assistant"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Import component files -->
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="arm.xacro"/>
  <xacro:include filename="gripper.xacro"/>

  <!-- Robot parameters -->
  <xacro:property name="base_radius" value="0.15"/>
  <xacro:property name="base_height" value="0.30"/>

  <xacro:property name="lift_travel" value="0.70"/>

  <xacro:property name="link1_length" value="0.40"/>
  <xacro:property name="link2_length" value="0.30"/>

  <xacro:property name="gripper_span" value="0.12"/>

  <!-- Materials -->
  <material name="base_grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="lift_blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="link1_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <material name="link2_red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <material name="palm_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="finger_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- Instantiate base -->
  <xacro:base
      name="base_link"
      base_radius="${base_radius}"
      base_height="${base_height}"/>

  <!-- Instantiate arm -->
  <xacro:arm
      parent="base_link"
      mount_z="${base_height}"
      link1_length="${link1_length}"
      link2_length="${link2_length}"
      lift_travel="${lift_travel}"/>

  <!-- Instantiate gripper -->
  <xacro:gripper
      parent="link2"
      attach_x="${link2_length}"
      gripper_span="${gripper_span}"/>

</robot>
